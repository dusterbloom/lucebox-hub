+// gfx1151 dense T=1 GEMV on the K-quant decode copies (qwen4exp LUCE_DECODE_REQ q5_K / q6_K: attn_qkv, attn_gate,
+// ssm_out, attn_q/k/v/output). The generic kernel runs one 32-lane wave per row on RDNA3.5 (table RDNA2) and
+// streams Q5_K / Q6_K at 211-222 GB/s against 227-231 for Q8_0 / Q5_1 (bench/exact/decode-requant/gemv.sh);
+// this one keeps the lane -> block mapping and the per-lane vec_dot of the generic kernel and adds the knobs the
+// generic one cannot take per call: nwarps waves per row (split K, cross-wave partials summed in shared memory
+// in wave order as the generic nwarps > 1 path does), the K loop unrolled `unroll` times, rows_per_wave rows
+// per wave sharing the q8_1 loads. nwarps == 1, rows_per_wave == 1 is bit-identical to the generic kernel for
+// any unroll (same per-lane accumulation order, same warp reduction). Dense only: no ids, no fusion, one
+// channel, one sample.
+template <ggml_type type, int nwarps, int unroll, int rows_per_wave>
+__launch_bounds__(nwarps * 32, 1)
+static __global__ void mul_mat_vec_q_kq_dense(
+        const void * __restrict__ vx, const block_q8_1 * __restrict__ y, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t stride_row_x) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int warp_size = 32;
+    constexpr int blocks_per_iter = vdr * nwarps * warp_size / qi;
+    static_assert(unroll == 1 || unroll == 2 || unroll == 4, "unroll");
+
+    const int tid  = warp_size * threadIdx.y + threadIdx.x;
+    const int row0 = rows_per_wave * blockIdx.x;
+    const int blocks_per_row = ncols_x / qk;
+    const int kqs  = vdr * (tid % (qi / vdr));
+
+    float tmp[rows_per_wave] = { 0.0f };
+#define KQ_DENSE_BODY                                                                                      \
+    for (int kbx = tid / (qi / vdr); kbx < blocks_per_row; kbx += blocks_per_iter) {                       \
+        const int kby = kbx * (qk / QK8_1);                                                                \
+        _Pragma("unroll")                                                                                  \
+        for (int r = 0; r < rows_per_wave; ++r) {                                                          \
+            tmp[r] += vec_dot_q_mmvq<type, false>(vx, &y[kby], (row0 + r) * (int) stride_row_x + kbx, kqs); \
+        }                                                                                                  \
+    }
+    if constexpr (unroll == 4) {
+#pragma unroll 4
+        KQ_DENSE_BODY
+    } else if constexpr (unroll == 2) {
+#pragma unroll 2
+        KQ_DENSE_BODY
+    } else {
+        KQ_DENSE_BODY
+    }
+#undef KQ_DENSE_BODY
+
+    if constexpr (nwarps > 1) {
+        __shared__ float tmp_shared[nwarps - 1][rows_per_wave][warp_size];
+        if (threadIdx.y > 0) {
+#pragma unroll
+            for (int r = 0; r < rows_per_wave; ++r) {
+                tmp_shared[threadIdx.y - 1][r][threadIdx.x] = tmp[r];
+            }
+        }
+        __syncthreads();
+        if (threadIdx.y > 0) {
+            return;
+        }
+#pragma unroll
+        for (int r = 0; r < rows_per_wave; ++r) {
+#pragma unroll
+            for (int l = 0; l < nwarps - 1; ++l) {
+                tmp[r] += tmp_shared[l][r][threadIdx.x];
+            }
+        }
+    }
+#pragma unroll
+    for (int r = 0; r < rows_per_wave; ++r) {
+        tmp[r] = warp_reduce_sum<warp_size>(tmp[r]);
+        if (threadIdx.x == 0) {
+            dst[row0 + r] = tmp[r];
+        }
+    }
+}
+
+// The words one lane of the generic vec_dot loads for one block (vec_dot_q5_K_q8_1 / vec_dot_q6_K_q8_1 in
+// vecdotq.cuh, same addresses, same conversions) and the same reduction on them, split so the loads of the next
+// block can be issued before this block is reduced.
+template <ggml_type type> struct kq_lane_words;
+
+template <> struct kq_lane_words<GGML_TYPE_Q5_K> {
+    int vl[2], vh[2], u[2 * QR5_K];
+    float d8[QR5_K];
+    half2 dm;
+    uint32_t aux;   // sc[0..1] | m[0..1] of this lane's two sub-blocks
+
+    __device__ __forceinline__ void load(const void * __restrict__ vx, const block_q8_1 * __restrict__ bq8_1,
+                                         const int kbx, const int iqs) {
+        const block_q5_K * bq5_K = (const block_q5_K *) vx + kbx;
+        const int bq8_offset = QR5_K * ((iqs / 2) / (QI8_1 / 2));
+        const int * ql = (const int *) (bq5_K->qs + 16 * bq8_offset + 4 * ((iqs / 2) % 4));
+        const int * qh = (const int *) (bq5_K->qh + 4 * ((iqs / 2) % 4));
+        vl[0] = ql[0];
+        vl[1] = ql[4];
+        vh[0] = qh[0] >> bq8_offset;
+        vh[1] = qh[4] >> bq8_offset;
+        const uint16_t * scales = (const uint16_t *) bq5_K->scales;
+        uint16_t a[2];
+        const int j = bq8_offset / 2;
+        if (j < 2) {
+            a[0] = scales[j + 0] & 0x3f3f;
+            a[1] = scales[j + 2] & 0x3f3f;
+        } else {
+            a[0] = ((scales[j + 2] >> 0) & 0x0f0f) | ((scales[j - 2] & 0xc0c0) >> 2);
+            a[1] = ((scales[j + 2] >> 4) & 0x0f0f) | ((scales[j - 0] & 0xc0c0) >> 2);
+        }
+        aux = (uint32_t) a[0] | ((uint32_t) a[1] << 16);
+        dm = bq5_K->dm;
+#pragma unroll
+        for (int i = 0; i < QR5_K; ++i) {
+            const block_q8_1 * bq8i = bq8_1 + bq8_offset + i;
+            d8[i] = __low2float(bq8i->ds);
+            const int * q8 = (const int *) bq8i->qs + ((iqs / 2) % 4);
+            u[2 * i + 0] = q8[0];
+            u[2 * i + 1] = q8[4];
+        }
+    }
+    __device__ __forceinline__ float dot() const {
+        const uint8_t * sc = (const uint8_t *) &aux;
+        return vec_dot_q5_K_q8_1_impl_vmmq(vl, vh, u, sc, sc + 2, dm, d8);
+    }
+};
+
+template <> struct kq_lane_words<GGML_TYPE_Q6_K> {
+    int vl, vh, u[QR6_K];
+    float d8[QR6_K];
+    float d;
+    int8_t sc[2];   // scales[scale_offset], scales[scale_offset + 4]
+
+    __device__ __forceinline__ void load(const void * __restrict__ vx, const block_q8_1 * __restrict__ bq8_1,
+                                         const int kbx, const int iqs) {
+        const block_q6_K * bq6_K = (const block_q6_K *) vx + kbx;
+        const int bq8_offset = 2 * QR6_K * (iqs / (QI6_K / 2)) + (iqs % (QI6_K / 2)) / (QI6_K / 4);
+        const int scale_offset = (QI6_K / 4) * (iqs / (QI6_K / 2)) + (iqs % (QI6_K / 2)) / (QI6_K / 8);
+        const int vh_shift = 2 * ((iqs % (QI6_K / 2)) / (QI6_K / 4));
+        vl = get_int_b2(bq6_K->ql, iqs);
+        vh = get_int_b2(bq6_K->qh, (QI6_K / 4) * (iqs / (QI6_K / 2)) + iqs % (QI6_K / 4)) >> vh_shift;
+        sc[0] = bq6_K->scales[scale_offset];
+        sc[1] = bq6_K->scales[scale_offset + 4];
+        d = bq6_K->d;
+#pragma unroll
+        for (int i = 0; i < QR6_K; ++i) {
+            u[i]  = get_int_b4(bq8_1[bq8_offset + 2 * i].qs, iqs % QI8_1);
+            d8[i] = __low2float(bq8_1[bq8_offset + 2 * i].ds);
+        }
+    }
+    __device__ __forceinline__ float dot() const {
+        int8_t scales[5] = { sc[0], 0, 0, 0, sc[1] };
+        return vec_dot_q6_K_q8_1_impl_mmvq(vl, vh, u, scales, d, d8);
+    }
+};
+
+// One wave per row, the generic lane -> block mapping, software-pipelined: block kbx + blocks_per_iter is loaded
+// before block kbx is reduced, so a lane always has two blocks of loads in flight. Bit-identical to the generic
+// kernel (same words, same per-lane accumulation order, same warp reduction).
+template <ggml_type type>
+__launch_bounds__(32, 1)
+static __global__ void mul_mat_vec_q_kq_dense_pipe(
+        const void * __restrict__ vx, const block_q8_1 * __restrict__ y, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t stride_row_x) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int blocks_per_iter = vdr * 32 / qi;
+
+    const int row = blockIdx.x;
+    const int blocks_per_row = ncols_x / qk;
+    const int kqs  = vdr * (threadIdx.x % (qi / vdr));
+    const int kbx0 = threadIdx.x / (qi / vdr);
+    const int row_off = row * (int) stride_row_x;
+
+    float tmp = 0.0f;
+    kq_lane_words<type> cur, nxt;
+    if (kbx0 < blocks_per_row) {
+        cur.load(vx, &y[kbx0 * (qk / QK8_1)], row_off + kbx0, kqs);
+    }
+    for (int kbx = kbx0; kbx < blocks_per_row; kbx += blocks_per_iter) {
+        const int kn = kbx + blocks_per_iter;
+        if (kn < blocks_per_row) {
+            nxt.load(vx, &y[kn * (qk / QK8_1)], row_off + kn, kqs);
+        }
+        tmp += cur.dot();
+        cur = nxt;
+    }
+    tmp = warp_reduce_sum<32>(tmp);
+    if (threadIdx.x == 0) {
+        dst[row] = tmp;
+    }
+}
+
+// Opt-in: LUCE_KQ_DENSE=w<nwarps>u<unroll>r<rows_per_wave> picks a launch-shape variant, LUCE_KQ_DENSE=pipe the
+// software-pipelined one (bench/exact/decode-requant/gemv.sh sweeps them, RESULTS.md has the numbers: none beats
+// the generic kernel beyond noise on gfx1151, so unset = the generic kernel). unroll 0 encodes the pipelined
+// kernel, nwarps 0 the generic one.
+struct mmvq_kq_dense_cfg { int nwarps, unroll, rows; };
+static mmvq_kq_dense_cfg g_kq_dense_override { -1, 0, 0 };
+// Tests: force a variant (nwarps 0 = the generic kernel, -1 = back to the env selection).
+extern "C" GGML_BACKEND_API void ggml_backend_cuda_set_kq_dense_for_test(int nwarps, int unroll, int rows) {
+    g_kq_dense_override = { nwarps, unroll, rows };
+}
+static mmvq_kq_dense_cfg mmvq_kq_dense_config() {
+    if (g_kq_dense_override.nwarps >= 0) {
+        return g_kq_dense_override;
+    }
+    static const mmvq_kq_dense_cfg cfg = [] {
+        mmvq_kq_dense_cfg c { 0, 0, 0 };
+        if (const char * e = std::getenv("LUCE_KQ_DENSE")) {
+            if (std::strcmp(e, "pipe") == 0) {
+                return mmvq_kq_dense_cfg { 1, 0, 1 };
+            }
+            if (std::sscanf(e, "w%du%dr%d", &c.nwarps, &c.unroll, &c.rows) != 3) {
+                c = { 0, 0, 0 };
+            }
+        }
+        return c;
+    }();
+    return cfg;
+}
+
+template <ggml_type type>
+static bool mul_mat_vec_q_kq_dense_launch(
+        const void * vx, const void * vy, float * dst, const uint32_t ncols_x, const uint32_t nrows_x,
+        const uint32_t stride_row_x, cudaStream_t stream) {
+    const mmvq_kq_dense_cfg cfg = mmvq_kq_dense_config();
+    if (cfg.nwarps == 0 || nrows_x % cfg.rows != 0) {
+        return false;
+    }
+    const dim3 block_nums(nrows_x / cfg.rows), block_dims(32, cfg.nwarps, 1);
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+    if (cfg.unroll == 0) {
+        if (cfg.nwarps != 1 || cfg.rows != 1) {
+            return false;
+        }
+        mul_mat_vec_q_kq_dense_pipe<type><<<block_nums, block_dims, 0, stream>>>(vx, y, dst, ncols_x, stride_row_x);
+        return true;
+    }
+#define KQ_DENSE_LAUNCH(W, U, R)                                                                         \
+    if (cfg.nwarps == W && cfg.unroll == U && cfg.rows == R) {                                             \
+        mul_mat_vec_q_kq_dense<type, W, U, R><<<block_nums, block_dims, 0, stream>>>(vx, y, dst, ncols_x, stride_row_x); \
+        return true;                                                                                       \
+    }
+    KQ_DENSE_LAUNCH(1, 1, 1) KQ_DENSE_LAUNCH(1, 2, 1) KQ_DENSE_LAUNCH(1, 4, 1)
+    KQ_DENSE_LAUNCH(1, 1, 2) KQ_DENSE_LAUNCH(1, 2, 2) KQ_DENSE_LAUNCH(1, 4, 2)
+    KQ_DENSE_LAUNCH(2, 1, 1) KQ_DENSE_LAUNCH(2, 2, 1) KQ_DENSE_LAUNCH(2, 4, 1)
+    KQ_DENSE_LAUNCH(2, 1, 2) KQ_DENSE_LAUNCH(2, 2, 2)
+    KQ_DENSE_LAUNCH(4, 1, 1) KQ_DENSE_LAUNCH(4, 2, 1) KQ_DENSE_LAUNCH(4, 4, 1)
+    KQ_DENSE_LAUNCH(4, 1, 2) KQ_DENSE_LAUNCH(4, 2, 2)
+    KQ_DENSE_LAUNCH(8, 1, 1) KQ_DENSE_LAUNCH(8, 2, 1)
+#undef KQ_DENSE_LAUNCH
+    return false;
+}
