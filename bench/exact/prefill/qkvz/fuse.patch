diff --git a/server/test/unit/test_qkvz_fuse_parity.cpp b/server/test/unit/test_qkvz_fuse_parity.cpp
new file mode 100644
index 00000000..0a2da66b
--- /dev/null
+++ b/server/test/unit/test_qkvz_fuse_parity.cpp
@@ -0,0 +1,154 @@
+// Parity test for the GDN qkv|gate row-concat GEMM (qwen4exp_loader.cpp attn_qkvz, qwen4exp_graph.cpp
+// build_linear_attn; LUCE_QKVZ_FUSE_LEGACY=1 keeps the two GEMMs). Rebuilds the prefill subgraph both ways on
+// synthetic Q8_0 weights under the qwen4exp CUDA profile (the mmb Q8_0 -> F16 GEMM route, as in production):
+//   legacy: qkv = W_qkv x, z = W_z x (two GEMMs, dense outputs)
+//   fused:  qkvz = [W_qkv ; W_z] x, qkv / z = column views with row pitch 16384
+// and then the consumers that must read the strided views: transpose -> concat(hist) -> SSM_CONV with the folded
+// q/k norm (gdn_conv_direct, which must match -- the generic kernel aborts when the norm is requested without the
+// fusion) -> silu, and gated_rms_norm_f16(attn, gamma, z). The silu output, the new conv history and the gated
+// norm output must be byte-identical between the arms. T = 1028 (fusion + raster path), 300 (fusion, ragged),
+// 200 (below the fusion's T >= 256: plain SSM_CONV over the generic concat of the strided view).
+// SKIP (77) without a GPU.
+#include "ggml-backend.h"
+#include "ggml-cuda.h"
+#include "ggml-impl.h"   // ggml_set_op_params_*: the folded q/k norm request lives in SSM_CONV op_params
+#include "ggml.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace {
+
+constexpr int64_t K = 2560, D = 128, Hk = 16, Hv = 48, Cq = 2 * Hk * D + Hv * D /* 10240 */, Cz = Hv * D /* 6144 */;
+
+uint64_t fnv(const void * p, size_t n, uint64_t h) {
+    const unsigned char * b = (const unsigned char *) p;
+    for (size_t i = 0; i < n; ++i) { h ^= b[i]; h *= 1099511628211ull; }
+    return h;
+}
+
+struct Lcg {
+    uint32_t r;
+    float next(float scale) { r = r * 1664525u + 1013904223u; return scale * (((r >> 8) & 0xFFFF) / 32768.0f - 1.0f); }
+};
+
+// Q8_0 rows quantised on the host; the concat weight is the byte concat of the two (rows are self-contained).
+std::vector<uint8_t> q8_rows(Lcg & g, int64_t rows) {
+    const size_t row_bytes = ggml_row_size(GGML_TYPE_Q8_0, K);
+    std::vector<uint8_t> out(row_bytes * rows);
+    std::vector<float> row(K);
+    for (int64_t r = 0; r < rows; ++r) {
+        for (float & v : row) v = g.next(0.05f);
+        ggml_quantize_chunk(GGML_TYPE_Q8_0, row.data(), out.data() + r * row_bytes, 0, 1, K, nullptr);
+    }
+    return out;
+}
+
+struct Case { uint64_t hash = 0; bool ok = false; };
+
+Case run(ggml_backend_t gpu, int64_t T, bool fused, const std::vector<uint8_t> & wq, const std::vector<uint8_t> & wz,
+         const std::vector<float> & x, const std::vector<float> & hist0, const std::vector<float> & conv_w,
+         const std::vector<float> & attn, const std::vector<float> & gamma) {
+    Case res;
+    ggml_init_params ip{ 64 * 1024 * 1024, nullptr, true };
+    ggml_context * cw = ggml_init(ip);
+    ggml_tensor * Wq = ggml_new_tensor_2d(cw, GGML_TYPE_Q8_0, K, Cq);
+    ggml_tensor * Wz = ggml_new_tensor_2d(cw, GGML_TYPE_Q8_0, K, Cz);
+    ggml_tensor * Wqz = ggml_new_tensor_2d(cw, GGML_TYPE_Q8_0, K, Cq + Cz);
+    ggml_backend_buffer_t bufw = ggml_backend_alloc_ctx_tensors(cw, gpu);
+    if (!bufw) { ggml_free(cw); return res; }
+    ggml_backend_buffer_set_usage(bufw, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    ggml_backend_tensor_set(Wq, wq.data(), 0, wq.size());
+    ggml_backend_tensor_set(Wz, wz.data(), 0, wz.size());
+    ggml_backend_tensor_set(Wqz, wq.data(), 0, wq.size());
+    ggml_backend_tensor_set(Wqz, wz.data(), wq.size(), wz.size());
+
+    ggml_context * c = ggml_init(ip);
+    ggml_tensor * X     = ggml_new_tensor_2d(c, GGML_TYPE_F32, K, T);
+    ggml_tensor * state = ggml_new_tensor_1d(c, GGML_TYPE_F32, 3 * Cq);
+    ggml_tensor * CW    = ggml_new_tensor_2d(c, GGML_TYPE_F32, 4, Cq);
+    ggml_tensor * A     = ggml_new_tensor_3d(c, GGML_TYPE_F32, D, Hv, T);
+    ggml_tensor * G     = ggml_new_tensor_1d(c, GGML_TYPE_F32, D);
+    for (ggml_tensor * t : { X, state, CW, A, G }) ggml_set_input(t);
+    ggml_cgraph * gf = ggml_new_graph(c);
+
+    ggml_tensor * qkv, * z;
+    if (fused) {
+        ggml_tensor * qkvz = ggml_mul_mat(c, Wqz, X);
+        qkv = ggml_view_2d(c, qkvz, Cq, T, qkvz->nb[1], 0);
+        z   = ggml_view_2d(c, qkvz, Cz, T, qkvz->nb[1], (size_t) Cq * sizeof(float));
+    } else {
+        qkv = ggml_mul_mat(c, Wq, X);
+        z   = ggml_mul_mat(c, Wz, X);
+    }
+    // build_linear_attn's prefill conv chain.
+    ggml_tensor * hist = ggml_reshape_3d(c, state, 3, Cq, 1);
+    ggml_tensor * qkv_t = ggml_transpose(c, qkv);
+    ggml_tensor * conv_input = ggml_concat(c, hist, qkv_t, 0);
+    ggml_tensor * new_hist = ggml_cont(c, ggml_view_3d(c, conv_input, 3, Cq, 1, conv_input->nb[1], conv_input->nb[2],
+                                                       (size_t) T * conv_input->nb[0]));
+    ggml_build_forward_expand(gf, ggml_cpy(c, new_hist, ggml_reshape_3d(c, state, 3, Cq, 1)));
+    ggml_tensor * conv_op = ggml_ssm_conv(c, conv_input, CW);
+    conv_op->src[3] = qkv_t;
+    if (T >= 256) {
+        ggml_set_op_params_i32(conv_op, 1, (int32_t) (2 * Hk * D));
+        ggml_set_op_params_f32(conv_op, 2, 1e-6f / (float) D);
+        ggml_set_op_params_f32(conv_op, 3, 1.0f / sqrtf((float) D));
+        ggml_set_op_params_f32(conv_op, 4, 0.0f);
+    }
+    ggml_tensor * conv = ggml_silu(c, conv_op);
+    ggml_tensor * gated = ggml_gated_rms_norm_f16(c, A, G, z, 1e-6f);
+    for (ggml_tensor * t : { conv, gated }) { ggml_set_output(t); ggml_build_forward_expand(gf, t); }
+
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(c, gpu);
+    if (!buf) { ggml_backend_buffer_free(bufw); ggml_free(cw); ggml_free(c); return res; }
+    ggml_backend_tensor_set(X, x.data(), 0, ggml_nbytes(X));
+    ggml_backend_tensor_set(state, hist0.data(), 0, ggml_nbytes(state));
+    ggml_backend_tensor_set(CW, conv_w.data(), 0, ggml_nbytes(CW));
+    ggml_backend_tensor_set(A, attn.data(), 0, ggml_nbytes(A));
+    ggml_backend_tensor_set(G, gamma.data(), 0, ggml_nbytes(G));
+    res.ok = ggml_backend_graph_compute(gpu, gf) == GGML_STATUS_SUCCESS;
+    uint64_t h = 1469598103934665603ull;
+    for (ggml_tensor * t : { conv, state, gated }) {
+        std::vector<uint8_t> v(ggml_nbytes(t));
+        ggml_backend_tensor_get(t, v.data(), 0, v.size());
+        h = fnv(v.data(), v.size(), h);
+    }
+    res.hash = h;
+    ggml_backend_buffer_free(buf);
+    ggml_backend_buffer_free(bufw);
+    ggml_free(cw);
+    ggml_free(c);
+    return res;
+}
+
+}  // namespace
+
+int main() {
+    ggml_backend_t gpu = ggml_backend_cuda_init(0);
+    if (!gpu) { std::printf("[qkvz-fuse] SKIP: no GPU\n"); return 77; }
+    ggml_backend_cuda_set_qwen4exp_profile(GGML_CUDA_QWEN4EXP_DEFAULT);
+    Lcg g{ 7u };
+    const std::vector<uint8_t> wq = q8_rows(g, Cq), wz = q8_rows(g, Cz);
+    bool ok = true;
+    for (int64_t T : { 1028, 300, 200 }) {
+        std::vector<float> x((size_t) K * T), hist0((size_t) 3 * Cq), conv_w((size_t) 4 * Cq), attn((size_t) D * Hv * T), gamma(D);
+        for (float & v : x) v = g.next(1.0f);
+        for (float & v : hist0) v = g.next(1.0f);
+        for (float & v : conv_w) v = g.next(0.5f);
+        for (float & v : attn) v = g.next(2.0f);
+        for (float & v : gamma) v = 1.0f + g.next(0.25f);
+        const Case legacy = run(gpu, T, false, wq, wz, x, hist0, conv_w, attn, gamma);
+        const Case fused  = run(gpu, T, true,  wq, wz, x, hist0, conv_w, attn, gamma);
+        const bool pass = legacy.ok && fused.ok && legacy.hash == fused.hash;
+        std::printf("[qkvz-fuse] T=%lld legacy %llx fused %llx %s\n", (long long) T,
+                    (unsigned long long) legacy.hash, (unsigned long long) fused.hash, pass ? "PASS" : "FAIL");
+        ok = ok && pass;
+    }
+    ggml_backend_free(gpu);
+    return ok ? 0 : 1;
+}
