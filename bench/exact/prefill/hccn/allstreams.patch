+// All-streams variants (prefill): one block per token handles every stream of the hyper-connection row in one
+// pass, so the 4 residual streams' loads are in flight together and the 4 block reductions share a single
+// __syncthreads (s_sum[HC][32]) instead of 4 serial block_reduce round trips. Per-element expressions, the
+// per-thread partial sums (same column -> thread map, same accumulation statement) and the shuffle order of the
+// reduction are those of hc_combine_norm_f32_b256 / hc_combine_norm_moe_f32_b256, so the outputs are bit-identical.
+// LUCE_HC_CN_ALL=0 restores the per-stream / per-token-serial kernels.
+#define HC_CN_MAX_HC 4
+template <int HC>
+static __device__ __forceinline__ void hc_cn_reduce_all(float (&tmp)[HC], float (*s_sum)[32]) {
+    const int lane = threadIdx.x % WARP_SIZE, warp = threadIdx.x / WARP_SIZE;
+#pragma unroll
+    for (int c = 0; c < HC; ++c) {
+        tmp[c] = warp_reduce_sum(tmp[c]);
+        if (lane == 0) s_sum[c][warp] = tmp[c];
+    }
+    __syncthreads();
+#pragma unroll
+    for (int c = 0; c < HC; ++c) {
+        float v = 0.0f;
+        if (lane < HC_CN_BLOCK2 / WARP_SIZE) v = s_sum[c][lane];
+        tmp[c] = warp_reduce_sum(v);
+    }
+}
+
+template <int HC>
+static __global__ void __launch_bounds__(HC_CN_BLOCK2, 2) hc_combine_norm_f32_all(
+        const float * inject, const float * residual, const float * block_out, const float * gamma,
+        float * out_res, float * out_xn, uint16_t * out_xn_bf16, const bool store_xn_f32,
+        const int n_embd, const float s1, const float b1, const float s2, const float b2, const float eps,
+        int8_t * q8) {
+    __shared__ float s_sum[HC][32];
+    const int t = blockIdx.x, tid = threadIdx.x;
+    constexpr int KP = (HC_CN_MAX_EMB / 2 + HC_CN_BLOCK2 - 1) / HC_CN_BLOCK2;
+    float w[HC], tmp[HC];
+#pragma unroll
+    for (int c = 0; c < HC; ++c) {
+        const float x1 = s1 * inject[(int64_t) t * HC + c] + b1;
+        const float x2 = hc_sigmoid(x1);
+        w[c] = s2 * x2 + b2;
+        tmp[c] = 0.0f;
+    }
+    const float * blk = block_out + (int64_t) t * n_embd;
+    float xs[HC][2 * KP];
+#pragma unroll
+    for (int k = 0; k < KP; ++k) {
+        const int col = (tid + k * HC_CN_BLOCK2) * 2;
+        if (col + 1 < n_embd) {
+            const float2 mv = *(const float2 *)(blk + col);
+            const float m0 = mv.x, m1 = mv.y;
+#pragma unroll
+            for (int c = 0; c < HC; ++c) {
+                const int64_t row = (int64_t) t * HC + c;
+                const float2 v = *(const float2 *)(residual + row * n_embd + col);
+                const float a0 = hc_add_rn(v.x, hc_mul_rn(m0, w[c]));
+                const float a1 = hc_add_rn(v.y, hc_mul_rn(m1, w[c]));
+                *(float2 *)(out_res + row * n_embd + col) = make_float2(a0, a1);
+                xs[c][2 * k] = a0; xs[c][2 * k + 1] = a1;
+                tmp[c] += a0 * a0 + a1 * a1;
+            }
+        } else {
+#pragma unroll
+            for (int c = 0; c < HC; ++c) { xs[c][2 * k] = 0.0f; xs[c][2 * k + 1] = 0.0f; }
+            if (col < n_embd) {
+                const float m0 = blk[col];
+#pragma unroll
+                for (int c = 0; c < HC; ++c) {
+                    const int64_t row = (int64_t) t * HC + c;
+                    const float a0 = hc_add_rn(residual[row * n_embd + col], hc_mul_rn(m0, w[c]));
+                    out_res[row * n_embd + col] = a0;
+                    xs[c][2 * k] = a0;
+                    tmp[c] += a0 * a0;
+                }
+            }
+        }
+    }
+    hc_cn_reduce_all<HC>(tmp, s_sum);
+#pragma unroll
+    for (int c = 0; c < HC; ++c) {
+        const float mean  = tmp[c] / n_embd;
+        const float scale = rsqrtf(mean + eps);
+        const int64_t row = (int64_t) t * HC + c;
+        const float * g  = gamma  + (int64_t) c * n_embd;
+        float *       xn = out_xn + row * n_embd;
+        uint16_t *    xh = out_xn_bf16 ? out_xn_bf16 + row * n_embd : nullptr;
+#pragma unroll
+        for (int k = 0; k < KP; ++k) {
+            const int col = (tid + k * HC_CN_BLOCK2) * 2;
+            if (col + 1 < n_embd) {
+                const float2 gv = *(const float2 *)(g + col);
+                const float v0 = scale * xs[c][2 * k] * gv.x, v1 = scale * xs[c][2 * k + 1] * gv.y;
+                if (store_xn_f32) *(float2 *)(xn + col) = make_float2(v0, v1);
+                if (xh) *(uint32_t *)(xh + col) = hc_pack2(v0, v1);
+                if (q8) hc_q8_pair(q8, HC * n_embd / 32, t, c * n_embd + col, v0, v1);
+            } else if (col < n_embd) {
+                const float v0 = scale * xs[c][2 * k] * g[col];
+                if (store_xn_f32) xn[col] = v0;
+                if (xh) xh[col] = hc_f2bf32(v0);
+            }
+        }
+    }
+}
