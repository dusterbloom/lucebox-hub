+static bool hc_cn_all_enabled() {
+    static const bool v = [] { const char * e = getenv("LUCE_HC_CN_ALL"); return !(e && atoi(e) == 0); }();
+    return v;
+}
+// The all-streams kernels take over for hc == 4 batches (one block per token wants a batch; decode keeps the
+// per-stream grid and the q8_1 producer).
+static bool hc_cn_use_all(const int64_t hc, const int64_t n_tokens) {
+    return hc_cn_all_enabled() && hc == HC_CN_MAX_HC && n_tokens >= 16;
+}
