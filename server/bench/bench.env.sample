# server/bench/bench.env.sample
#
# Copy to bench.env (gitignored), edit the paths to match your machine, then:
#   set -a; source server/bench/bench.env; set +a
# before running any bench script.

# --- Models ---------------------------------------------------------------

# Target model (27B Q4_K_M GGUF). The model the pflash+dflash stack is being
# benched against. Tested with Qwen3.6-27B; other dense ~27B Q4_K_M models
# should work but speedups may differ.
export TARGET=/path/to/your/models/Qwen3.6-27B-Q4_K_M.gguf

# pFlash prefill drafter (small Qwen3 family, ~0.6B). Used by
# `--prefill-drafter` to score chunks for compression. Q8_0 recommended.
export PFLASH_DRAFT=/path/to/your/models/Qwen3-0.6B-Q8_0.gguf

# dFlash decode drafter (matched ~3.6 family, Q4_K_M). Used by `--draft`
# for speculative decode in the decode loop.
export DECODE_DRAFT=/path/to/your/models/dflash-draft-3.6-q4_k_m.gguf

# Legacy alias — same as DECODE_DRAFT (common.sh reads $DRAFT for --draft).
export DRAFT="$DECODE_DRAFT"

# --- Binary ---------------------------------------------------------------

# Path to the built dflash_server binary.
#   cmake --build server/build --target dflash_server -j$(nproc)
export DFLASH_SERVER_BIN=/path/to/your/lucebox-hub/server/build/dflash_server

# --- Clients (only the ones you run) --------------------------------------

# Required for any agentic / multi-client bench. Install with the matching
# CLI (npm i -g @anthropic-ai/claude-code  etc.) and point at the binary.
export CLAUDE_BIN=/path/to/your/.local/bin/claude
export CODEX_BIN=/path/to/your/.local/bin/codex
export PI_BIN=/path/to/your/.local/bin/pi
export HERMES_BIN=/path/to/your/.local/bin/hermes
export OPENCODE_BIN=/path/to/your/.local/bin/opencode

# --- Optional tuning (defaults usually fine) ------------------------------

# pflash compression knobs — leave unset for adaptive defaults (per memory
# `project_64k_quality_cliff`, anchor_radius scales with n_chunks).
# export PFLASH_COMPRESS_ANCHOR_RADIUS=4
# export PFLASH_COMPRESS_MAX_ANCHOR_HITS=16
# export PFLASH_COMPRESS_ANCHOR_TRANSITIVE=1   # enable multi-hop cascade

# pflash mode override (otherwise the bench script picks)
# export PFLASH_DRAFTER_EARLY_EXIT_N=7
# export PFLASH_DRAFTER_SCORE_LAYERS=7
