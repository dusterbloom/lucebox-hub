  "question": "How often do route12/B16 and route12/B20 disagree on native-qualified behavior, and what terminal full-vocabulary KL do they produce on the same forced native histories?",
  "exactness_scope": {
    "native_equivalence": "Neither B16 nor B20 can be native-exact because route12 and omitted-slab means discard authoritative information.",
    "b20_equivalence": "The measured add-after-rounding B16-plus-four implementation already failed exact all-layer B20 equivalence and is not rerun here.",
    "future_exact_rescue": "An exact B20 rescue must defer state commit and execute the canonical B20 reduction, or restore and replay canonical B20. Reused payload residency is allowed; equality must cover logits, output IDs, routes, recurrent state hashes, and traffic accounting."
  },
  "lanes": {
    "free_run": {
      "purpose": "Measure actual greedy behavior, generated token IDs, valid JSON/tool/code output, and B16/B20 disagreement.",
      "history_rule": "Do not compute KL after generated histories diverge.",
      "native_qualification": "A fixture contributes to candidate retention only if Full192 native passes its registered checker. Native failures remain reported but are excluded from the retention denominator."
    },
    "aligned_terminal": {
      "purpose": "Measure one terminal full-vocabulary distribution per fixture on a common history.",
      "history_rule": "Replay the Full192 native generated token IDs under every arm before capturing the next-token logits. Verify prompt token IDs and forced history token IDs byte-for-byte.",
      "metrics": [
        "terminal KL mean",
        "terminal KL median",
        "terminal KL p95",
        "terminal KL maximum",
        "top-1 agreement",
        "native-token margin"
      ],
      "non_claim": "One terminal point per prompt is not a per-token sequence KL curve."
    }
  },
  "arms": {
    "native_full192": {
      "route_count": 16,
      "slab_budget": 192,
      "role": "teacher and native task qualifier"
    },
    "h23_aggressive1p8": {
      "role": "frozen H23 1.8-GiB comparison"
    },
    "h23_moonshot1p2": {
      "role": "frozen H23 1.2-GiB comparison"
    },
    "route12_budget20": {
      "route_count": 12,
      "slab_budget": 20,
      "role": "richer static BWS control"
    },
    "route12_budget16": {
      "route_count": 12,
      "slab_budget": 16,
      "role": "cheap base and disagreement probe"
    }
  },
